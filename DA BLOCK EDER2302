-- ------------------------------
-- FUNCIÓN PARA CARGAR TU MENÚ ORIGINAL
-- ------------------------------
function CargarMenuPrincipal()
    local character = player.Character or player.CharacterAdded:Wait()
    local root = character:WaitForChild("HumanoidRootPart")
    local humanoid = character:WaitForChild("Humanoid")
    local minimizado = false

    player.CharacterAdded:Connect(function(new)
        character = new
        root = new:WaitForChild("HumanoidRootPart")
        humanoid = new:WaitForChild("Humanoid")
    end)

    local toggles = {speed=false, fly=false, noclip=false, god=false, esp=false, silent=false, farm=false, jump=false}
    local walkSpeedValue = 120
    local autoFarmDelay = 6

    local locations = {
        ["Tienda de Armas"] = Vector3.new(3807.15, 4.87, 219.97),
        ["Burger King"] = Vector3.new(3649.73, 4.70, 528.54),
        ["Motel"] = Vector3.new(3326.04, 4.28, 52.71),
        ["Joyería"] = Vector3.new(4065.32, 4.29, -339.37),
        ["Banco"] = Vector3.new(4148.41, 4.28, -52.02),
        ["Concesionario"] = Vector3.new(4536.16, 5.06, 226.48),
        ["Basquetball"] = Vector3.new(4112.87, 4.39, 312.74),
        ["Gym"] = Vector3.new(3557.72, 4.29, -412.91),
        ["Police Station"] = Vector3.new(4004.16, 11.91, -751.80),
        ["Farmacia"] = Vector3.new(4318.52, 5.17, -523.02),
        ["Haircuts"] = Vector3.new(4251.77, 8.20, -371.79)
    }

    local function TP(pos)
        if root then root.CFrame = CFrame.new(pos + Vector3.new(0,8,0)) end
    end

    -- GUI
    local sg = Instance.new("ScreenGui")
    sg.ResetOnSpawn = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.Parent = playerGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 430, 0, 620)
    frame.Position = UDim2.new(0.5, -215, 0.5, -310)
    frame.BackgroundColor3 = Color3.fromRGB(22,22,28)
    frame.Active = true
    frame.Parent = sg

    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1,0,0,50)
    titleBar.BackgroundColor3 = Color3.fromRGB(180,0,40)
    titleBar.Active = true
    titleBar.ZIndex = 10
    titleBar.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1,0,1,0)
    title.BackgroundTransparency = 1
    title.Text = txt.titulo
    title.TextColor3 = Color3.new(1,1,1)
    title.TextScaled = true
    title.ZIndex = 9
    title.Parent = titleBar

    -- ✅ ARRASTRE ARREGLADO 100%
    local dragging = false
    local offset = Vector2.new()

    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            offset = UserInputService:GetMouseLocation() - frame.AbsolutePosition
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local nuevaPos = UserInputService:GetMouseLocation() - offset
            frame.Position = UDim2.new(0, nuevaPos.X, 0, nuevaPos.Y)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    -- Scroll (TU VERSIÓN ORIGINAL)
    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1,-10,1,-55)
    scroll.Position = UDim2.new(0,5,0,55)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 8
    scroll.Parent = frame

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0,8)
    layout.Parent = scroll

    local function AddButton(text, callback)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1,-10,0,50)
        btn.BackgroundColor3 = Color3.fromRGB(40,40,50)
        btn.Text = text
        btn.TextColor3 = Color3.new(1,1,1)
        btn.TextScaled = true
        btn.Parent = scroll
        if callback then btn.MouseButton1Click:Connect(callback) end
        return btn
    end

    -- Botones principales TRADUCIDOS
    AddButton(txt.velocidad.."OFF", function(b) toggles.speed = not toggles.speed b.Text = txt.velocidad..(toggles.speed and "ON" or "OFF") end)
    AddButton(txt.volar.."OFF", function(b) toggles.fly = not toggles.fly b.Text = txt.volar..(toggles.fly and "ON" or "OFF") end)
    AddButton(txt.noclip.."OFF", function(b) toggles.noclip = not toggles.noclip b.Text = txt.noclip..(toggles.noclip and "ON" or "OFF") end)
    AddButton(txt.dios.."OFF", function(b) toggles.god = not toggles.god b.Text = txt.dios..(toggles.god and "ON" or "OFF") end)
    AddButton(txt.granja.."OFF", function(b) toggles.farm = not toggles.farm b.Text = txt.granja..(toggles.farm and "ON" or "OFF") end)

    -- TP Menu Colapsable
    local tpOpen = false
    local tpButtons = {}

    local tpMainBtn = AddButton(txt.tpLoc.."▼", function()
        tpOpen = not tpOpen
        for _, btn in pairs(tpButtons) do btn.Visible = tpOpen end
        tpMainBtn.Text = txt.tpLoc..(tpOpen and "▲" or "▼")
    end)

    for name, pos in pairs(locations) do
        local btn = AddButton("   → "..name, function() TP(pos) end)
        btn.Visible = false
        table.insert(tpButtons, btn)
    end

    -- Minimizar agregado
    AddButton(txt.minimizar, function(b)
        minimizado = not minimizado
        b.Text = minimizado and txt.restaurar or txt.minimizar
        frame.Size = minimizado and UDim2.new(0,430,0,50) or UDim2.new(0,430,0,620)
        scroll.Visible = not minimizado
    end)

    AddButton(txt.cerrar, function() sg:Destroy() end)

    -- Loops ORIGINALES
    RunService.RenderStepped:Connect(function()
        if toggles.speed and humanoid then humanoid.WalkSpeed = walkSpeedValue end
        if toggles.noclip and character then
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end)

    print(txt.cargado)
end
