                                for _, obj in ipairs(inventario:GetChildren()) do
                                    if obj:IsA("Tool") or obj:IsA("HopperBin") then
                                        table.insert(lista, obj.Name)
                                    end
                                end
                            end
                            if hum and hum:FindFirstChild("Tool") then
                                table.insert(lista, "✅ "..hum.Tool.Name.." (Equipado)")
