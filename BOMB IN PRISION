local function actualizarListaServidoresConFiltro()
   for _, child in ipairs(ScrollingFrame:GetChildren()) do
      if child:IsA("TextButton") then
         child:Destroy()
      end
   end

   pcall(function()
      local servers = {}
      local cursor = ""
      for i = 1, 3 do
         local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
         if cursor ~= "" then
            url = url .. "&cursor=" .. cursor
         end
         local req = game:HttpGet(url)
         local data = HttpService:JSONDecode(req)
         if data and data.data then
            for _, s in ipairs(data.data) do
               if s.playing and s.maxPlayers and s.playing <= maxJugadoresBuscados and s.playing < s.maxPlayers then
                  table.insert(servers, {id = s.id, playing = s.playing, max = s.maxPlayers})
               end
            end
            if data.nextPageCursor then
               cursor = data.nextPageCursor
            else
               break
            end
         else
            break
         end
      end

      table.sort(servers, function(a, b)
         return a.playing < b.playing
      end)

      if #servers > 0 then
         for index, s in ipairs(servers) do
            local ServerBtn = Instance.new("TextButton")
            ServerBtn.Size = UDim2.new(1, -10, 0, 40)
            ServerBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            ServerBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            ServerBtn.TextSize = 14
            ServerBtn.Font = Enum.Font.SourceSans
            ServerBtn.Text = " Servidor #" .. index .. " | Gente: " .. s.playing .. "/" .. s.max
            ServerBtn.Parent = ScrollingFrame

            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(0, 6)
            BtnCorner.Parent = ServerBtn

            ServerBtn.MouseButton1Click:Connect(function()
               Rayfield:Notify({
                  Title = "Teletransportando",
                  Content = "Entrando al servidor con " .. s.playing .. " jugadores...",
                  Duration = 3,
                  Image = 4483362458,
               })
               TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
            end)
         end
      else
         local NoServerBtn = Instance.new("TextButton")
         NoServerBtn.Size = UDim2.new(1, -10, 0, 40)
         NoServerBtn.BackgroundColor3 = Color3.fromRGB(50, 30, 30)
         NoServerBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
         NoServerBtn.TextSize = 13
         NoServerBtn.Font = Enum.Font.SourceSans
         NoServerBtn.Text = "No hay servidores con <= " .. maxJugadoresBuscados .. " jugadores."
         NoServerBtn.Parent = ScrollingFrame
      end
   end)
end

