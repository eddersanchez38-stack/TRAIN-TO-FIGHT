-- Función para mover al jugador caminando
local function caminarHacia(pos)
   local character = LocalPlayer.Character
   if not character or not character:FindFirstChild("HumanoidRootPart") then return end
   local humanoid = character:FindFirstChildOfClass("Humanoid")
   local rootPart = character.HumanoidRootPart

   if humanoid then
      humanoid:MoveTo(pos)
      
      local reached = false
      local connection
      connection = RunService.Stepped:Connect(function()
         if (rootPart.Position - pos).Magnitude < 4 then
            reached = true
            humanoid:MoveTo(rootPart.Position)
            connection:Disconnect()
         end
      end)

      local startTick = tick()
      while not reached and (tick() - startTick < 15) do
         task.wait(0.1)
         if not character or not character.Parent then 
            connection:Disconnect()
            break 
         end
      end
      connection:Disconnect()
   end
end

-- Función para activar ProximityPrompts cercanos
local function activarProximityPromptCercano()
   local character = LocalPlayer.Character
   if not character or not character:FindFirstChild("HumanoidRootPart") then return end
   local rootPart = character.HumanoidRootPart

   for _, descendant in ipairs(workspace:GetDescendants()) do
      if descendant:IsA("ProximityPrompt") then
         local parent = descendant.Parent
         local partPos = nil
         if parent:IsA("BasePart") then
            partPos = parent.Position
         elseif parent:IsA("Model") and parent.PrimaryPart then
            partPos = parent.PrimaryPart.Position
         end

         if partPos and (rootPart.Position - partPos).Magnitude <= (descendant.MaxActivationDistance + 5) then
            fireproximityprompt(descendant)
         end
      end
   end
end

-- Función para simular clics en la pantalla por 10 segundos y descansar por 5 segundos (Stats)
local function loopAccionPantalla(duracionTrabajo, duracionDescanso)
   local tiempoInicio = tick()
   while (tick() - tiempoInicio < duracionTrabajo) and 
         (farmingArms or farmingChest or farmingBack or farmingAbs or farmingLegs or farmingFood or farmingEvolution) do
      
      VirtualUser:Button1Down(Vector2.new(0,0))
      task.wait(0.1)
      VirtualUser:Button1Up(Vector2.new(0,0))
      
      task.wait(0.5)
   end
   
   if farmingArms or farmingChest or farmingBack or farmingAbs or farmingLegs or farmingFood or farmingEvolution then
      task.wait(duracionDescanso)
   end
end

-- Función para clics muy rápidos en Auto Fight durante 15 segundos
local function loopAutoFight(flagCheckFunc)
   local tiempoInicio = tick()
   while (tick() - tiempoInicio < 15) and flagCheckFunc() do
      VirtualUser:Button1Down(Vector2.new(0,0))
      task.wait(0.02)
      VirtualUser:Button1Up(Vector2.new(0,0))
      task.wait(0.02)
   end
end

