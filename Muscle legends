-- Función robusta para obtener los valores exactos según su ruta
local function obtenerValorStat(plr, clave)
	if not plr then return 0 end
	local valObj = nil
	local leaderstats = plr:FindFirstChild("leaderstats")
	
	if leaderstats then
		valObj = leaderstats:FindFirstChild(clave)
	end
	
	if not valObj then
		valObj = plr:FindFirstChild(clave)
	end
	
	if valObj and (valObj:IsA("NumberValue") or valObj:IsA("IntValue")) then
		return valObj.Value
	end
	return 0
end

