local function crearTabContent(nombre)
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, 0, 1, 0)
	scroll.BackgroundTransparency = 1
	scroll.CanvasSize = UDim2.new(0, 0, 0, 850)
	scroll.ScrollBarThickness = 4
	scroll.Visible = false
	scroll.Parent = contentFrame

	local layout = Instance.new("UIListLayout", scroll)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 6)

	tabs[nombre] = scroll
	return scroll
end

local function cambiarTab(nombre)
	for _, tab in pairs(tabs) do tab.Visible = false end
	if tabs[nombre] then tabs[nombre].Visible = true end
end

