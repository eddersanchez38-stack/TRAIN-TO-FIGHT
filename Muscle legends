local function crearToggleEnTab(parent, texto, estadoInicial, callback)
	local activo = estadoInicial
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -5, 0, 32)
	btn.BackgroundColor3 = activo and Color3.fromRGB(40, 140, 60) or Color3.fromRGB(45, 40, 70)
	btn.Text = texto .. (activo and " [ON]" or " [OFF]")
	btn.TextColor3 = Color3.new(1,1,1)
	btn.TextSize = 11
	btn.Font = Enum.Font.GothamBold
	btn.Parent = parent
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
	btn.MouseButton1Click:Connect(function()
		activo = not activo
		btn.BackgroundColor3 = activo and Color3.fromRGB(40, 140, 60) or Color3.fromRGB(45, 40, 70)
		btn.Text = texto .. (activo and " [ON]" or " [OFF]")
		callback(activo)
	end)
	return btn
end

local function crearBotonEnTab(parent, texto, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -5, 0, 32)
	btn.BackgroundColor3 = Color3.fromRGB(55, 45, 85)
	btn.Text = texto
	btn.TextColor3 = Color3.new(1,1,1)
	btn.TextSize = 11
	btn.Font = Enum.Font.GothamBold
	btn.Parent = parent
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
	btn.MouseButton1Click:Connect(callback)
	return btn
end

