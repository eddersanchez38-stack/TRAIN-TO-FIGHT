		if jugadorSeleccionado and jugadorSeleccionado.Parent then
			local datosUsuario = jugadoresTiempoIngreso[jugadorSeleccionado.UserId]
			local tiempoEnServidor = datosUsuario and (tiempoTotal - datosUsuario.tiempo) or 1

			for clave, datos in pairs(spyStatLabels) do
