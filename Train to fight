-- Fast Train
local function FastTrain()
    pcall(function()
        local TE = ReplicatedStorage:FindFirstChild("TrainEquipment")
        local TS = ReplicatedStorage:FindFirstChild("TrainSystem")
        if not TE or not TS then return end
        local ER = TE:FindFirstChild("Remote")
        local SR = TS:FindFirstChild("Remote")
        if not ER or not SR then return end

        local Stationary = ER:FindFirstChild("ApplyStationaryTrain")
        local Mobile = ER:FindFirstChild("ApplyMobileTrain")
        local Speed = SR:FindFirstChild("TrainSpeedHasChanged")
        local Frenzy = SR:FindFirstChild("ApplyAddFrenzyValue")

        if Stationary then Stationary:InvokeServer(math.huge) end
        if Mobile then Mobile:InvokeServer(math.huge) end
        if Speed then
            Speed:FireServer(math.huge)
            Speed:FireServer(math.huge)
        end
        if Frenzy then
            Frenzy:InvokeServer(10000)
            Frenzy:FireServer(math.huge)
        end
    end)
end

-- Fly
local function StartFly()
    if FlyConnection then FlyConnection:Disconnect() end
    FlyEnabled = true

    local BV = Instance.new("BodyVelocity")
    BV.Velocity = Vector3.zero
    BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    BV.Parent = HRP

    local BG = Instance.new("BodyGyro")
    BG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    BG.P = 90000
    BG.Parent = HRP

    local Keys = {}
    local KD = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        Keys[input.KeyCode] = true
    end)
    local KU = UserInputService.InputEnded:Connect(function(input)
        Keys[input.KeyCode] = false
    end)

    FlyConnection = RunService.RenderStepped:Connect(function()
        local cam = workspace.CurrentCamera
        local move = Vector3.zero
        if Keys[Enum.KeyCode.W] then move = move + cam.CFrame.LookVector end
        if Keys[Enum.KeyCode.S] then move = move - cam.CFrame.LookVector end
        if Keys[Enum.KeyCode.A] then move = move - cam.CFrame.RightVector end
        if Keys[Enum.KeyCode.D] then move = move + cam.CFrame.RightVector end
        if Keys[Enum.KeyCode.E] then move = move + Vector3.new(0, 1, 0) end
        if Keys[Enum.KeyCode.Q] then move = move - Vector3.new(0, 1, 0) end

        if move.Magnitude > 0 then
            BV.Velocity = move.Unit * FlySpeed
        else
            BV.Velocity = Vector3.zero
        end
        BG.CFrame = cam.CFrame
        if Humanoid then Humanoid.PlatformStand = true end
    end)

    _G.FlyBV = BV
    _G.FlyBG = BG
    _G.FlyKD = KD
    _G.FlyKU = KU
end

local function StopFly()
    FlyEnabled = false
    if FlyConnection then FlyConnection:Disconnect() FlyConnection = nil end
    pcall(function()
        if Humanoid then Humanoid.PlatformStand = false end
        HRP.Velocity = Vector3.zero
        if _G.FlyBV then _G.FlyBV:Destroy() end
        if _G.FlyBG then _G.FlyBG:Destroy() end
        if _G.FlyKD then _G.FlyKD:Disconnect() end
        if _G.FlyKU then _G.FlyKU:Disconnect() end
    end)
end

