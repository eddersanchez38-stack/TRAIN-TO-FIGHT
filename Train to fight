    local tInfo = TweenInfo.new(0.4)
    TweenService:Create(Fondo, tInfo, {BackgroundTransparency = 1}):Play()
    TweenService:Create(TextoPorc, tInfo, {TextTransparency = 1}):Play()
    TweenService:Create(TextoHub, tInfo, {TextTransparency = 1}):Play()
    TweenService:Create(TextoSub, tInfo, {TextTransparency = 1}):Play()
    TweenService:Create(BarraFondo, tInfo, {BackgroundTransparency = 1}):Play()
    TweenService:Create(BarraProg, tInfo, {BackgroundTransparency = 1}):Play()
    task.wait(0.45)
    CargaUI:Destroy()

    Config = {
        WalkSpeed = false,
        AutoTpPlayers = false,
        Fly = false,
        ClickTp = false,
        WalkSpeedVal = 96, -- x6 por defecto (16 * 6)
        FlySpeed = 35,
        MaxFlySpeed = 80,
        TpDelay = 2
    }
    AutoTrain = false
    Connections = {}
    ListaJugadores = {}
    IndiceActual = 0

    local function ActualizarPersonaje(nuevoChar)
        char = nuevoChar
        hum = char:WaitForChild("Humanoid")
        root = char:WaitForChild("HumanoidRootPart")
        UltimaAltura = root.Position.Y
    end
    ActualizarPersonaje(LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait())
    LocalPlayer.CharacterAdded:Connect(ActualizarPersonaje)

    function Toggle(state)
        AutoTrain = state
        for _, c in ipairs(Connections) do if c then c:Disconnect() end end
        table.clear(Connections)
        if AutoTrain then
            table.insert(Connections, RunService.RenderStepped:Connect(function()
                pcall(function()
                    local TE = ReplicatedStorage:FindFirstChild("TrainEquipment")
                    local TS = ReplicatedStorage:FindFirstChild("TrainSystem")
                    if not TE or not TS then return end
                    local ER = TE:FindFirstChild("Remote")
                    local SR = TS:FindFirstChild("Remote")
                    if not ER or not SR then return end
                    local Stationary = ER:FindFirstChild("ApplyStationaryTrain")
                    local Mobile = ER:FindFirstChild("ApplyMobileTrain")
                    local Speed = SR:FindFirstChild("TrainSpeedHasChanged")
                    local Frenzy = SR:FindFirstChild("ApplyAddFrenzyValue")
                    if Stationary then Stationary:InvokeServer(math.huge) end
                    if Mobile then Mobile:InvokeServer(math.huge) end
                    if Speed then Speed:FireServer(math.huge) Speed:FireServer(math.huge) end
                    if Frenzy then Frenzy:InvokeServer(10000) Frenzy:FireServer(math.huge) end
                end)
            end))
        end
    end

    local function ActualizarListaJugadores()
        ListaJugadores = {}
        for _, jug in ipairs(Players:GetPlayers()) do
            if jug ~= LocalPlayer and jug.Character and jug.Character:FindFirstChild("HumanoidRootPart") and jug.Character.Humanoid.Health > 0 then
                table.insert(ListaJugadores, jug)
            end
        end
    end

    task.spawn(function()
        while true do
            task.wait(Config.TpDelay)
            if not Config.AutoTpPlayers or not root then
                ListaJugadores = {} IndiceActual = 0
                continue
            end
            ActualizarListaJugadores()
            if #ListaJugadores == 0 then continue end
            IndiceActual = IndiceActual + 1
            if IndiceActual > #ListaJugadores then IndiceActual = 1 end
            local Objetivo = ListaJugadores[IndiceActual]
            if Objetivo and Objetivo.Character and Objetivo.Character:FindFirstChild("HumanoidRootPart") then
                root.CFrame = CFrame.new(Objetivo.Character.HumanoidRootPart.Position + Vector3.new(0, 3, -5))
            end
        end
    end)

    local function CrearPlataforma()
        if Plataforma then Plataforma:Destroy() end
        Plataforma = Instance.new("Part")
        Plataforma.Name = "PlataformaVuelo"
        Plataforma.Size = Vector3.new(3, 0.3, 3)
        Plataforma.Transparency = 0.4
        Plataforma.Color = Color3.fromRGB(50, 200, 255)
        Plataforma.Anchored = true
        Plataforma.CanCollide = true
        Plataforma.CastShadow = false
        Plataforma.Parent = workspace
        Instance.new("UICorner", Plataforma).CornerRadius = UDim.new(0, 8)
    end

    function ToggleFly(estado)
        Config.Fly = estado
        if estado then
            CrearPlataforma()
            UltimaAltura = root.Position.Y
            FlyConn = RunService.Heartbeat:Connect(function()
                if not Config.Fly or not root or not Plataforma then return end
                local posActual = root.Position
                local nuevaPos = posActual - Vector3.new(0, 1.8, 0)
                Plataforma.Position = nuevaPos
                local cam = workspace.CurrentCamera
                local dir = Vector3.new()
                if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
                if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir += Vector3.new(0, -1, 0) end
                root.Velocity = dir.Magnitude > 0 and dir.Unit * Config.FlySpeed or Vector3.new(0,0,0)
            end)
        else
            if FlyConn then FlyConn:Disconnect() end
            FlyConn = nil
            if Plataforma then Plataforma:Destroy() end
            Plataforma = nil
            root.Velocity = Vector3.new(0,0,0)
        end
    end

    local Mouse = LocalPlayer:GetMouse()
    Mouse.Button1Down:Connect(function()
        if Config.ClickTp and root and Mouse.Target then
            root.CFrame = CFrame.new(Mouse.Hit.Position + Vector3.new(0, 2, 0))
        end
    end)

    -- 🏃 Control robusto de WalkSpeed (Fuerza la velocidad constantemente mediante Heartbeat)
    local function ToggleWalkSpeed(estado)
        Config.WalkSpeed = estado
        if estado then
            if walkConn then walkConn:Disconnect() end
            walkConn = RunService.Heartbeat:Connect(function()
                pcall(function()
                    if hum and hum.Parent then
                        hum.WalkSpeed = Config.WalkSpeedVal
                    end
                end)
            end)
        else
            if walkConn then walkConn:Disconnect() walkConn = nil end
            pcall(function()
                if hum and hum.Parent then
                    hum.WalkSpeed = 16
                end
            end)
        end
    end

