local function DoFastTrain()
    pcall(function()
        local te = RS:FindFirstChild("TrainEquipment")
        local ts = RS:FindFirstChild("TrainSystem")
        if not (te and ts) then return end
        local er = te:FindFirstChild("Remote")
        local sr = ts:FindFirstChild("Remote")
        if not (er and sr) then return end

        local a = er:FindFirstChild("ApplyStationaryTrain")
        local b = er:FindFirstChild("ApplyMobileTrain")
        local c = sr:FindFirstChild("TrainSpeedHasChanged")
        local d = sr:FindFirstChild("ApplyAddFrenzyValue")

        if a then a:InvokeServer(math.huge) end
        if b then b:InvokeServer(math.huge) end
        if c then c:FireServer(math.huge) c:FireServer(math.huge) end
        if d then d:InvokeServer(10000) d:FireServer(math.huge) end
    end)
end

local function StartFly()
    if FlyCon then FlyCon:Disconnect() end
    FlyOn = true
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(9e9,9e9,9e9)
    bv.Velocity = Vector3.zero
    bv.Parent = HRP
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(9e9,9e9,9e9)
    bg.P = 9e4
    bg.Parent = HRP

    local keys = {}
    local kd = UIS.InputBegan:Connect(function(i,g) if not g then keys[i.KeyCode]=true end end)
    local ku = UIS.InputEnded:Connect(function(i) keys[i.KeyCode]=false end)

    FlyCon = RunService.RenderStepped:Connect(function()
        if not HRP or not HRP.Parent then return end
        local cam = workspace.CurrentCamera
        local m = Vector3.zero
        if keys[Enum.KeyCode.W] then m = m + cam.CFrame.LookVector end
        if keys[Enum.KeyCode.S] then m = m - cam.CFrame.LookVector end
        if keys[Enum.KeyCode.A] then m = m - cam.CFrame.RightVector end
        if keys[Enum.KeyCode.D] then m = m + cam.CFrame.RightVector end
        if keys[Enum.KeyCode.E] then m = m + Vector3.new(0,1,0) end
        if keys[Enum.KeyCode.Q] then m = m - Vector3.new(0,1,0) end
        bv.Velocity = m.Magnitude > 0 and m.Unit * 50 or Vector3.zero
        bg.CFrame = cam.CFrame
        if Hum then Hum.PlatformStand = true end
    end)
    _G.FBV, _G.FBG, _G.FKD, _G.FKU = bv, bg, kd, ku
end

local function StopFly()
    FlyOn = false
    if FlyCon then FlyCon:Disconnect() FlyCon = nil end
    pcall(function()
        if Hum then Hum.PlatformStand = false end
        if HRP then HRP.Velocity = Vector3.zero end
        if _G.FBV then _G.FBV:Destroy() end
        if _G.FBG then _G.FBG:Destroy() end
        if _G.FKD then _G.FKD:Disconnect() end
        if _G.FKU then _G.FKU:Disconnect() end
    end)
end

