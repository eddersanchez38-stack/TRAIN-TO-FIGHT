-- 📊 ANIMAR CARGA Y ARRANCAR RAYFIELD
task.spawn(function()
    for i = 8, 100, 2 do
        task.wait(0.035)
        TextoPorc.Text = tostring(i) .. "%"
        BarraProg.Size = UDim2.new(i/100, 0, 1, 0)
    end
