local activeTouchId = nil
local lastTouchPosition = Vector2.new()

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not isFreeCamActive then return end
	
	if input.UserInputType == Enum.UserInputType.Touch and not activeTouchId then
		local pos = input.Position
		local function isTouching(btn)
			local bPos, bSize = btn.AbsolutePosition, btn.AbsoluteSize
			return (pos.X >= bPos.X and pos.X <= bPos.X + bSize.X and pos.Y >= bPos.Y and pos.Y <= bPos.Y + bSize.Y)
		end
		
		if not isTouching(toggleButton) and not isTouching(droneControlPanel) and not isTouching(hideHudButton) and not isTouching(lightButton) and not isTouching(nightVisionButton) and not isTouching(soundButton) and not isTouching(cinematicButton) then
			activeTouchId = input
			lastTouchPosition = Vector2.new(input.Position.X, input.Position.Y)
		end
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not isFreeCamActive then return end
	
	if input == activeTouchId and input.UserInputType == Enum.UserInputType.Touch then
		local currentPos = Vector2.new(input.Position.X, input.Position.Y)
		local delta = currentPos - lastTouchPosition
		lastTouchPosition = currentPos
		
		camRotation = camRotation - Vector2.new(delta.X * SENSITIVITY, delta.Y * SENSITIVITY)
		camRotation = Vector2.new(camRotation.X, math.clamp(camRotation.Y, -math.pi/2 + 0.01, math.pi/2 - 0.01))
	
	elseif UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrent
		local delta = UserInputService:GetMouseDelta()
		camRotation = camRotation - Vector2.new(delta.X * SENSITIVITY, delta.Y * SENSITIVITY)
		camRotation = Vector2.new(camRotation.X, math.clamp(camRotation.Y, -math.pi/2 + 0.01, math.pi/2 - 0.01))
	else
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input == activeTouchId then activeTouchId = nil end
end)

runService.RenderStepped:Connect(function(dt)
	if not isFreeCamActive then return end
	
	local moveInput = updateMovementInput()
	
	local yawCF = CFrame.Angles(0, camRotation.X, 0)
	local pitchCF = CFrame.Angles(camRotation.Y, 0, 0)
	local rotationCF = yawCF * pitchCF
	
	local moveDir = rotationCF:VectorToWorldSpace(moveInput)
	camPosition = camPosition + (moveDir * currentSpeed * dt)
	
	camera.CFrame = CFrame.new(camPosition) * rotationCF
	droneLightPart.CFrame = camera.CFrame
end)


