local function updateMovementInput()
	local x, y, z = 0, 0, 0
	if UserInputService:IsKeyDown(Enum.KeyCode.W) or movementStates.Forward then z = z - 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) or movementStates.Backward then z = z + 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) or movementStates.Left then x = x - 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) or movementStates.Right then x = x + 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) or movementStates.Up then y = y + 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or movementStates.Down then y = y - 1 end
	return Vector3.new(x, y, z)
end

local function toggleFreeCam()
	isFreeCamActive = not isFreeCamActive
	
	if isFreeCamActive then
		originalCameraType = camera.CameraType
		camera.CameraType = Enum.CameraType.Scriptable
		
		camPosition = camera.CFrame.Position
		local lookVector = camera.CFrame.LookVector
		camRotation = Vector2.new(math.atan2(-lookVector.X, -lookVector.Z), math.asin(lookVector.Y))
		
		droneSpotLight.Enabled = isLightOn
		if isSoundOn then pcall(function() droneSound:Play() end) end
		
		toggleButton.Text = "Cámara Dron: ON"
		toggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 127)
		btnStroke.Color = Color3.fromRGB(0, 255, 180)
		
		droneControlPanel.Visible = true
		hideHudButton.Visible = true
		lightButton.Visible = true
		nightVisionButton.Visible = true
		soundButton.Visible = true
		cinematicButton.Visible = true
		isHudVisible = true
		hideHudButton.Text = "👁️"
		hideHudButton.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
	else
		camera.CameraType = originalCameraType
		
		droneSpotLight.Enabled = false
		pcall(function() droneSound:Stop() end)
		
		nightVisionEffect.Enabled = false
		isNightVisionOn = false
		nightVisionButton.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
		nvStroke.Color = Color3.fromRGB(70, 70, 85)
		
		if isCinematicModeOn then
			isCinematicModeOn = false
			currentSpeed = savedSpeedBeforeCinematic
			SENSITIVITY = 0.005
			cinematicButton.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
			cineStroke.Color = Color3.fromRGB(70, 70, 85)
		end
		
		toggleButton.Text = "Cámara Dron: OFF"
		toggleButton.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
		btnStroke.Color = Color3.fromRGB(70, 70, 85)
		
		droneControlPanel.Visible = false
