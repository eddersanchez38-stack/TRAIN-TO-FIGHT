local function actualizarListaJugadores(filtro)
	filtro = filtro or ""
	for _, btn in pairs(playerListButtons) do
		if btn and btn.Parent then btn:Destroy() end
	end
	playerListButtons = {}

	local count = 0
	for _, p in pairs(Players:GetPlayers()) do
		if filtro == "" or string.find(string.lower(p.Name), string.lower(filtro), 1, true) then
			count = count + 1
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, 0, 0, 34)
			btn.BackgroundColor3 = Color3.fromRGB(38, 50, 70)
			btn.Text = "  " .. p.Name
			btn.TextColor3 = Color3.fromRGB(220, 220, 240)
			btn.TextSize = 13
			btn.Font = Enum.Font.Gotham
			btn.TextXAlignment = Enum.TextXAlignment.Left
			btn.AutoButtonColor = false
			btn.Parent = playerListFrame
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

			if p == jugadorSeleccionado then
				btn.BackgroundColor3 = Color3.fromRGB(25, 130, 90)
			end

			btn.MouseButton1Click:Connect(function()
				jugadorSeleccionado = p
				spyPlayerName.Text = "📊 " .. p.Name
				spyPlayerName.TextColor3 = Color3.fromRGB(100, 255, 160)

				if not jugadoresTiempoIngreso[p.UserId] then
					jugadoresTiempoIngreso[p.UserId] = {
						tiempo = tiempoTotal,
						valoresIniciales = {}
					}
					local lsP = p:FindFirstChild("leaderstats")
					for _, info in ipairs(spyStatNames) do
						local clave, tipo = info[2], info[3]
						if tipo == "leaderstats" and lsP and lsP:FindFirstChild(clave) then
							jugadoresTiempoIngreso[p.UserId].valoresIniciales[clave] = lsP[clave].Value
						elseif tipo == "player" and p:FindFirstChild(clave) then
							jugadoresTiempoIngreso[p.UserId].valoresIniciales[clave] = p[clave].Value
						end
					end
				end
				actualizarListaJugadores(filtro)
			end)
			table.insert(playerListButtons, btn)
		end
	end
	playerListFrame.CanvasSize = UDim2.new(0, 0, 0, count * 39 + 20)
end

