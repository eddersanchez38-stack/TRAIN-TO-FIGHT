-- LOOP PRINCIPAL
spawn(function()
	while wait(0.04) do
		colorFase = colorFase + 0.07

		local r = math.floor(math.sin(colorFase) * 127 + 128)
		local g = math.floor(math.sin(colorFase + 2) * 127 + 128)
		local b = math.floor(math.sin(colorFase + 4) * 127 + 128)
		local col = Color3.fromRGB(r, g, b)

		local r2 = math.floor(math.sin(colorFase + 1.5) * 127 + 128)
		local g2 = math.floor(math.sin(colorFase + 3.5) * 127 + 128)
