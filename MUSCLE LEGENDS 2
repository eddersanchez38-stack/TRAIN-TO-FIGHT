-- Loop
task.spawn(function()
	while task.wait(0.1) do
		colorFase = colorFase + 0.09
		local r = math.floor(math.sin(colorFase) * 127 + 128)
		local g = math.floor(math.sin(colorFase + 2) * 127 + 128)
		local b = math.floor(math.sin(colorFase + 4) * 127 + 128)
		local col = Color3.fromRGB(r, g, b)

		titulo.TextColor3 = col
		clientLabel.TextColor3 = col
		strokeMain.Color = col
		strokeScroll.Color = col
		strokeHatch.Color = col
		hatchBtn.BackgroundColor3 = Color3.fromRGB(
			math.clamp(r - 25, 50, 255),
			math.clamp(g - 45, 25, 255),
			math.clamp(b - 5, 90, 255)
		)

		if antiAfk then
			antiMenu.TextColor3 = col
			antiAfkLabel.TextColor3 = col
			tiempoAntiAfk = tiempoAntiAfk + 0.1
		else
			antiMenu.TextColor3 = Color3.fromRGB(110, 110, 110)
		end

		tiempoTotal = tiempoTotal + 0.1

		local function fmtTiempo(seg)
			local h = math.floor(seg/3600)
			local m = math.floor((seg%3600)/60)
			local s = math.floor(seg%60)
			return string.format("%02d:%02d:%02d", h, m, s)
		end

		antiMenu.Text = "ANTI-AFK: " .. fmtTiempo(tiempoAntiAfk)
		antiAfkLabel.Text = "ANTI-AFK: " .. fmtTiempo(tiempoAntiAfk)
		totalMenu.Text = "TIEMPO JUGADO: " .. fmtTiempo(tiempoTotal)
		if mostrarTiempo then
			tiempoLabel.Text = "TIEMPO JUGADO: " .. fmtTiempo(tiempoTotal)
		end

		for clave, datos in pairs(statLabels) do
			if datos.Obj and datos.Obj:IsA("NumberValue") then
				local valorActual = datos.Obj.Value
				local ganado = valorActual - (inicio[clave] or 0)
				local ganancia = calcularGananciaPorTiempo(ganado, tiempoTotal)
				datos.Label.Text = string.format("%s: %s (+%s)\n%s",
					datos.Nombre, formato(valorActual), formato(ganado), ganancia)
			else
				datos.Label.Text = datos.Nombre .. ": ---"
			end
		end

		if jugadorSeleccionado and tabActual == "Spy Stats" then
			local lsP = jugadorSeleccionado:FindFirstChild("leaderstats")
			local datosUsuario = jugadoresTiempoIngreso[jugadorSeleccionado.UserId]
			local tiempoEnServidor = datosUsuario and (tiempoTotal - datosUsuario.tiempo) or 0

			for clave, datos in pairs(spyStatLabels) do
				local valorObj = nil
				if datos.Tipo == "leaderstats" and lsP then
					valorObj = lsP:FindFirstChild(clave)
				elseif datos.Tipo == "player" then
					valorObj = jugadorSeleccionado:FindFirstChild(clave)
				end

				if valorObj and valorObj:IsA("NumberValue") then
					local valorActual = valorObj.Value
					local valorInicial = datosUsuario and datosUsuario.valoresIniciales[clave] or valorActual
					local ganado = valorActual - valorInicial
					local ganancia = calcularGananciaPorTiempo(ganado, tiempoEnServidor)
					datos.Label.Text = string.format("%s: %s (+%s)\n%s",
						datos.Nombre, formato(valorActual), formato(ganado), ganancia)
				else
					datos.Label.Text = datos.Nombre .. ": ---"
				end
			end
		end

		if lockPositivo and lockedCFrame then
			local char = player.Character
			if char and char:FindFirstChild("HumanoidRootPart") then
				char.HumanoidRootPart.CFrame = lockedCFrame
				char.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
				char.HumanoidRootPart.AssemblyAngularVelocity = Vector3.zero
			end
		end

		if antiAfk and math.floor(tiempoAntiAfk) % 50 == 0 then
			pcall(function()
				local cam = workspace.CurrentCamera
				cam.CFrame = cam.CFrame * CFrame.Angles(math.rad(0.5), 0, 0)
				task.wait(0.08)
				cam.CFrame = cam.CFrame * CFrame.Angles(math.rad(-0.5), 0, 0)
			end)
		end

		if abriendo and cristalSeleccionado and openCrystalRemote then
			pcall(function()
				openCrystalRemote:InvokeServer("openCrystal", cristalSeleccionado, 1)
			end)
		end

		if autoEvolve and autoEvolveRemote then
			pcall(function()
				autoEvolveRemote:InvokeServer()
			end)
		end

		if autoFastReps then
			mantenerTool("Weight")
			pcall(function()
				local muscleEvent = player:FindFirstChild("muscleEvent")
				if muscleEvent then
					muscleEvent:FireServer("rep")
				end
			end)
		end

		if autoPushups then
			mantenerTool("Pushups")
			pcall(function()
				local muscleEvent = player:FindFirstChild("muscleEvent")
				if muscleEvent then
					muscleEvent:FireServer("rep")
				end
			end)
		end

		if autoPunch then
			mantenerTool("Punch")
			pcall(function()
				local muscleEvent = player:FindFirstChild("muscleEvent")
				if muscleEvent then
					muscleEvent:FireServer("rep")
				end
			end)
		end
	end
end)

