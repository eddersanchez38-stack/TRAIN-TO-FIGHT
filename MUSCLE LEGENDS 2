local function formato(n)
	n = tonumber(n) or 0
	if n >= 1e18 then return string.format("%.1fOc", n/1e18)
	elseif n >= 1e15 then return string.format("%.1fSx", n/1e15)
	elseif n >= 1e12 then return string.format("%.1fT", n/1e12)
	elseif n >= 1e9 then return string.format("%.1fB", n/1e9)
	elseif n >= 1e6 then return string.format("%.1fM", n/1e6)
	elseif n >= 1e3 then return string.format("%.1fK", n/1e3)
	end return string.format("%.1f", n)
end

local function calcularGananciaPorTiempo(ganado, seg)
	if seg <= 0 then return "⏳ Calculando ganancias..." end
	local porMin = ganado / (seg / 60)
	local porHora = porMin * 60
	local porDia = porHora * 24
	local porSem = porDia * 7
	local porMes = porDia * 30
	return string.format("📈 /m: %s\n⚡ /h: %s\n🌟 /d: %s\n🚀 /sem: %s\n💎 /mes: %s",
		formato(porMin), formato(porHora), formato(porDia), formato(porSem), formato(porMes))
end

local function fmtTiempo(seg)
	local h = math.floor(seg/3600)
	local m = math.floor((seg%3600)/60)
	local s = math.floor(seg%60)
	return string.format("%02d:%02d:%02d", h, m, s)
end

local function equiparTool(nombre)
	pcall(function()
		local char = player.Character
		if not char then return end
		local tool = player.Backpack:FindFirstChild(nombre)
		if tool then tool.Parent = char end
	end)
end

local function mantenerTool(nombre)
	if muertoReciente then return end
	pcall(function()
		local char = player.Character
		if not char then return end
		if not char:FindFirstChild(nombre) then
			local tool = player.Backpack:FindFirstChild(nombre)
			if tool then tool.Parent = char end
		end
	end)
end

local function teleportTo(cf)
	pcall(function()
		local char = player.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			char.HumanoidRootPart.CFrame = cf
		end
	end)
end

