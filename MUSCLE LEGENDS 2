local function cambiarTab(nombre)
	tabActual = nombre
	contentFarm.Visible = (nombre == "Farm")
	contentCrystals.Visible = (nombre == "Crystals")
	contentTeleport.Visible = (nombre == "Teleport")
	contentStats.Visible = (nombre == "Stats")
	contentSpy.Visible = (nombre == "Spy Stats")

	for n, btn in pairs(tabButtons) do
		if n == nombre then
			btn.BackgroundColor3 = Color3.fromRGB(60, 60, 110)
			btn.TextColor3 = Color3.new(1,1,1)
		else
			btn.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
			btn.TextColor3 = Color3.fromRGB(170, 170, 190)
		end
	end

	if nombre == "Spy Stats" then
		actualizarListaJugadores()
	end
end

for name, btn in pairs(tabButtons) do
	btn.MouseButton1Click:Connect(function()
		cambiarTab(name)
	end)
end
